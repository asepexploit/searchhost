# Copy file ini jadi `.env` (di folder yang sama) lalu isi/sesuaikan nilainya.

# ---------- Kredensial Telegram API (my.telegram.org) ----------
# Kosongkan buat pakai mode otomatis (login ke my.telegram.org lewat nomor developer),
# atau isi manual kalau sudah punya api_id/api_hash sendiri dari https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# ---------- Auto-download ----------
# Ekstensi file yang otomatis didownload, pisah pakai koma. Default: .txt
TG_AUTO_DOWNLOAD_EXTENSIONS=.txt

# Berapa file boleh didownload BERSAMAAN (paralel) per akun. Default: 4
TG_MAX_CONCURRENT_DOWNLOADS=4

# ---------- Dashboard live monitoring ----------
TG_DASHBOARD_HOST=127.0.0.1
TG_DASHBOARD_PORT=8000

# ---------- Cleanup otomatis (file yang hilang dari disk) ----------
TG_CLEANUP_INTERVAL_SECONDS=120
TG_CLEANUP_CONFIRM_STREAK=2

# ---------- License-check ----------
# WAJIB DIISI -- minta ke admin.
LICENSE_CHECK_URL=
LICENSE_DEVICE_TOKEN=
LICENSE_CHECK_TIMEOUT_SECONDS=5
