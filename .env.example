# Copy file ini jadi `.env` (di folder yang sama) lalu isi/sesuaikan nilainya.

# ---------- Kredensial Telegram API (my.telegram.org) ----------
# Kosongkan buat pakai mode otomatis (login ke my.telegram.org lewat nomor developer),
# atau isi manual kalau sudah punya api_id/api_hash sendiri dari https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# ---------- Auto-download ----------
# Ekstensi file yang otomatis didownload, pisah pakai koma. Default: .txt
TG_AUTO_DOWNLOAD_EXTENSIONS=.txt

# Berapa file boleh didownload BERSAMAAN (paralel) per akun. Default: 4
TG_MAX_CONCURRENT_DOWNLOADS=4

# Berapa DIALOG (chat/grup/channel) boleh di-SCAN bersamaan sekaligus pas Backfill
# "Semua channel/grup" (scan metadata pesan, beda dari TG_MAX_CONCURRENT_DOWNLOADS
# yang itu buat transfer file). Default: 5
TG_BACKFILL_ALL_CONCURRENT_DIALOGS=5

# Berapa lama (detik) nunggu balasan bot sebelum dianggap gagal/timeout, buat fitur
# auto-fetch via bot ("DOWNLOAD FROM BOT" di post channel). Default: 25
TG_BOT_FETCH_TIMEOUT_SECONDS=25

# ---------- Dashboard live monitoring ----------
TG_DASHBOARD_HOST=127.0.0.1
TG_DASHBOARD_PORT=8000

# ---------- Cleanup otomatis (file yang hilang dari disk) ----------
TG_CLEANUP_INTERVAL_SECONDS=120
TG_CLEANUP_CONFIRM_STREAK=2

# ---------- Ketahanan koneksi listener 24/7 (monitor.py) ----------
# Berapa kali coba sambung ulang kalau koneksi Telegram putus, dan jeda (detik)
# antar-percobaan. Default: 10000x, jeda 5 detik.
TG_CONNECTION_RETRIES=10000
TG_RETRY_DELAY_SECONDS=5

# ---------- Backfill Relay Multi-Akun & Live Forwarder (opsional) ----------
# Kosongkan buat matiin fitur ini sepenuhnya (behavior lama: tiap akun download
# sendiri-sendiri, gak saling bantu).
#
# Link invite grup PRIVAT milik kamu sendiri yang dipakai sebagai "relay" -- pesan
# bermedia yang BUKAN jatah akun ini di-forward ke sini, biar akun lain yang jadi
# jatahnya ikut membantu download (round-robin, mengurangi flood-wait per akun).
TG_BACKFILL_RELAY_INVITE_LINK=

# Label akun (nomor HP akun Telegram yang login) yang MURNI forward pesan bermedia
# ke grup relay di atas, TIDAK PERNAH download sendiri -- cocok buat akun yang
# sengaja join banyak grup/channel sekaligus. Pisah koma kalau lebih dari 1 akun.
TG_LIVE_FORWARDER_ACCOUNTS=

# ---------- License-check ----------
# WAJIB DIISI -- minta ke admin.
LICENSE_CHECK_URL=
LICENSE_DEVICE_TOKEN=
LICENSE_CHECK_TIMEOUT_SECONDS=5
